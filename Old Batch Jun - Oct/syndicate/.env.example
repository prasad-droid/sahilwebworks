# Browser-side endpoint used by the inquiry form.
# Use a same-origin path when the bundled Node API is deployed with the site,
# or paste the full URL of an external form service (Formspree, Getform, etc.).
VITE_INQUIRY_ENDPOINT=/api/inquiries

# Server-side configuration (used by server.js)
PORT=3001
INQUIRY_STORE=./data/inquiries.json
