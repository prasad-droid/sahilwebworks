# Vite environment variables for DVK Enterprises website.
# 
# Copy this file to `.env` and set values as needed.
# Do NOT commit `.env` to version control (it contains local secrets).

# Set this to a POST endpoint that accepts JSON to enable real form submission.
# When empty (default), the InquiryForm falls back to a pre-filled WhatsApp message
# instead of pretending a submission succeeded.
VITE_INQUIRY_ENDPOINT=""